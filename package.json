  "description": "pi-subagents inspector plugin that opens subagent inspectors in your desktop's default terminal window.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
